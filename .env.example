APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Seguridad / API
# Orígenes CORS permitidos (coma-separado). No usar '*' con credenciales.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# La landing (`web/`) postea a /api/v1/leads: sumar su origen (dev: http://localhost:3004).
CORS_ALLOWED_ORIGIN_PATTERNS=
# Minutos de vida de un token Sanctum (1440 = 1 día).
SANCTUM_TOKEN_EXPIRATION=1440

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hotelignite
DB_USERNAME=hotelignite
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="mail@hotelignite.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# MCP del viajero: completa con datos simulados lo que falta (inventario,
# precios, tipos de habitación). Ignorado en producción. Ver docs/mcp-mocks-todo.md.
AI_MOCK_MISSING_DATA=false
# Estadía máxima (noches) que acepta una consulta de disponibilidad del agente.
AI_MAX_STAY_NIGHTS=30

# Casilla del staff que recibe los leads de la landing. Vacía → se guardan sin aviso.
API_LEADS_NOTIFY_EMAIL=
# Secreto de Cloudflare Turnstile del formulario de leads. Vacío → no se exige captcha.
# El site key va en la landing (web/: PUBLIC_TURNSTILE_SITE_KEY); sin él no hay token y todo lead da 422.
TURNSTILE_SECRET_KEY=

# Mercado Pago (suscripciones de planes)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# Vuelta desde Mercado Pago a /facturacion del PMS (https en producción).
MP_SUBSCRIPTION_BACK_URL=http://pms.hotelignite.local:3000/facturacion
# Sólo pruebas: email del comprador de prueba que paga la suscripción.
MP_TEST_PAYER_EMAIL=
