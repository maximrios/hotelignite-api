            "url": {
              "raw": "{{base_url}}/api/v1/cities",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "cities"]
            }
          }
        },
        {
          "name": "Agencias",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/agencies",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "agencies"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin V1 (user_type: platform)",
      "description": "Requiere un usuario `platform`. El usuario de prueba lo es.",
      "item": [
        {
          "name": "Alojamientos (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/admin/v1/accommodations",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "v1", "accommodations"]
            },
            "description": "Mismo endpoint que consumen el CRM y el panel de clientes. Devuelve distinta data según el `user_type` del token: un `client` queda acotado al pivot `accommodation_client`."
          }
        },
        {
          "name": "Cuentas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/admin/v1/accounts",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "v1", "accounts"]
            }
          }
        },
        {
          "name": "Usuarios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/admin/v1/users",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "v1", "users"]
            }
          }
        },
        {
          "name": "Planes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/admin/v1/plans",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "v1", "plans"]
            },
            "description": "Los planes son el catálogo de entitlements. La suscripción es por alojamiento (`accommodations.plan_id`), no por cuenta."
          }
        },
        {
          "name": "Provincias",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/admin/v1/states",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "v1", "states"]
            },
            "description": "Filtra por país vía `config('api.catalog_country_iso')`. La tabla `states` tiene 4119 filas de ~246 países: sin ese filtro la lista es inservible."
          }
        }
      ]
    }
  ]
}
