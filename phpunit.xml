<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <env name="CACHE_DRIVER" value="array"/>
    <!--
            Base dedicada para tests. NO apuntar esto a la base de desarrollo:
            cualquier test con RefreshDatabase ejecuta migrate:fresh y dropea
            todas las tablas. Con datos reales en dev (77 alojamientos, 1356
            reservas), una sola corrida la destruye.

            La suite usa DatabaseTransactions sobre una copia de los datos de
            dev. Alta de la base de tests (contenedor `pgsql` de dev):
              docker exec pgsql createdb -U hotelignite hotelignite_testing
              docker exec pgsql sh -c 'pg_dump -U hotelignite hotelignite | psql -qU hotelignite hotelignite_testing'
        -->
    <env name="DB_DATABASE" value="hotelignite_testing"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="TELESCOPE_ENABLED" value="false"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
