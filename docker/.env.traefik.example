# Variables del borde compartido (docker-compose.traefik.yml).
# Copiar a `.env.traefik` en el VPS. Son dos, y ninguna es secreta.

# Cuenta de Let's Encrypt: acá llegan los avisos de vencimiento si la renovación
# automática falla. Poné una casilla que leas.
ACME_EMAIL=maximrios@gmail.com

# INFO está bien para operar. DEBUG sólo mientras diagnosticás la emisión de un
# certificado: escupe muchísimo y el log rota a 10 MB × 5.
TRAEFIK_LOG_LEVEL=INFO
