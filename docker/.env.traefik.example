# Variables del borde compartido (docker-compose.traefik.yml).
# Copiar a `.env.traefik` en el VPS.

# Cuenta de Let's Encrypt: acá llegan los avisos si la renovación automática
# falla. Poné una casilla que leas.
ACME_EMAIL=maximrios@gmail.com

# Dominio raíz del VPS. El dashboard queda en `traefik.<DOMAIN>`.
DOMAIN=hotelignite.com

# Credenciales del dashboard, formato htpasswd (`usuario:hash`), varias
# separadas por coma. Generar con:
#
#   htpasswd -nbB admin 'una-password-larga'
#   # o sin apache2-utils:
#   docker run --rm httpd:alpine htpasswd -nbB admin 'una-password-larga'
#
# El hash de bcrypt lleva `$` (ej. `$2y$05$...`) y **compose interpola las
# variables dentro de este archivo**, así que sin protegerlo se te come el hash:
# medido con compose v2.29.7, `admin:$2y$05$Xk9p...` llega a Traefik como
# `admin:$2y$05` — el resto se tomó por una variable inexistente y quedó vacío.
# El síntoma es una password que "no anda" sin ningún error en el log.
#
# Dos formas de escaparlo, las dos verificadas. Usá las **comillas simples**:
# pegás el hash tal cual sale de htpasswd y listo.
#
#   DASHBOARD_USERS='admin:$2y$05$Xk9p...'      ✅ recomendado
#   DASHBOARD_USERS=admin:$$2y$$05$$Xk9p...     ✅ también sirve (duplicar cada $)
#   DASHBOARD_USERS=admin:$2y$05$Xk9p...        ❌ llega truncado
DASHBOARD_USERS='admin:$2y$05$CAMBIAME'
