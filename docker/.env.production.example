############################################################
# HotelIgnite — variables de producción
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production        # contiene secretos
#
# Se usa dos veces:
#   1) docker compose lo interpola (--env-file .env.production)
#   2) se inyecta como env_file en el contenedor del API
#
# No usar la sintaxis "${OTRA_VAR}" acá: docker no la resuelve dentro
# de env_file y Laravel recibiría el literal.
############################################################

# ---------------------------------------------------------- Dominio / TLS
API_DOMAIN=api.hotelignite.com
ACME_EMAIL=maximrios@gmail.com
TRAEFIK_LOG_LEVEL=INFO

# ---------------------------------------------------------- Imagen
API_IMAGE=hotelignite/api
API_TAG=latest

# ---------------------------------------------------------- Base de datos
# DB_HOST/DB_PORT los fija el compose (servicio "db"): no los pongas acá.
DB_CONNECTION=mysql
DB_DATABASE=hotelignite
DB_USERNAME=hotelignite
DB_PASSWORD=CAMBIAME_password_largo
DB_ROOT_PASSWORD=CAMBIAME_root_password_largo
MYSQL_BUFFER_POOL=512M

# ---------------------------------------------------------- Laravel
APP_NAME=HotelIgnite
APP_ENV=production
# Generar con:
#   docker compose --env-file .env.production -f docker-compose.prod.yml \
#       run --rm --no-deps api php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Salta
APP_URL=https://api.hotelignite.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Migrar automáticamente en cada arranque del contenedor api.
#
# Desde el 2026-08-31 `php artisan migrate` **sí corre desde una base vacía**
# (75 migraciones, 0 pendientes, las mismas 28 foreign keys que la base de
# desarrollo). Antes fallaba en la 15 por una FK fantasma a `rooms`.
#
# Aun así conviene el primer deploy con un dump del entorno actual: migrar desde
# cero te da el esquema, no los datos (77 alojamientos, usuarios, reservas). Con
# el dump importado —incluida la tabla `migrations`— poné true y cada arranque
# aplica sólo lo nuevo.
RUN_MIGRATIONS=false

# ---------------------------------------------------------- Rate limit del borde
# Middlewares de Traefik, que corren ANTES de php-fpm. El throttle de Laravel
# vive dentro de PHP: para cuando rechaza, la request ya ocupó un worker.
#
# RATELIMIT_AVERAGE/BURST: requests por minuto por IP de origen.
# INFLIGHT_AMOUNT: requests simultáneas por IP. Manténelo por debajo de
#   pm.max_children (docker/php-fpm.conf, hoy 20) o una sola IP puede quedarse
#   con todos los workers. Ése es el ataque realista: no saturar el enlace, sino
#   abrir unas pocas conexiones lentas.
RATELIMIT_AVERAGE=120
RATELIMIT_BURST=60
INFLIGHT_AMOUNT=15

# ---------------------------------------------------------- Proxies de confianza
# Rangos privados = la red de Docker, donde vive Traefik. Vacío usa ese default.
#
# NUNCA poner '*': Laravel pasa a confiar en toda la cadena X-Forwarded-For y
# devuelve la entrada de más a la izquierda, que la escribe el cliente. Con eso,
# cualquiera rota el header y evade TODO throttle por IP, incluido el de login.
#
# Al poner un CDN/WAF delante hay que sumar acá sus rangos (son públicos) Y
# agregarlos a --entrypoints.websecure.forwardedHeaders.trustedIPs en Traefik.
TRUSTED_PROXIES=

# ---------------------------------------------------------- Sesión / CORS / Sanctum
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.hotelignite.com

# Orígenes de los paneles (crm/clients/pms). Coma-separado, sin '*'.
CORS_ALLOWED_ORIGINS=https://crm.hotelignite.com,https://clients.hotelignite.com
CORS_ALLOWED_ORIGIN_PATTERNS=
SANCTUM_STATEFUL_DOMAINS=crm.hotelignite.com,clients.hotelignite.com
SANCTUM_TOKEN_EXPIRATION=1440

# ---------------------------------------------------------- Cache / colas
# Cache en Redis. Importa más de lo que parece: el rate limiter de Laravel se
# apoya en el cache por defecto, y sobre archivos cada chequeo era lectura +
# escritura + lock en disco. Bajo un flood el limiter se volvía parte del
# problema. REDIS_HOST/REDIS_PORT los fija el compose: no los pongas acá.
CACHE_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_MAXMEMORY=256mb

# Colas sobre MySQL (tablas `jobs` y `failed_jobs`), con el worker que corre
# supervisord dentro del contenedor. En `sync`, `Mail::queue()` enviaba el SMTP
# **dentro del request**: un lote de invitaciones retenía uno de los 20 workers
# de php-fpm durante todo el envío.
#
# No se usa el Redis de arriba a propósito: su política es `allkeys-lru`, la
# correcta para cache puro, y evictaría jobs pendientes. Para pasar las colas a
# Redis hace falta una segunda instancia sin eviction.
QUEUE_CONNECTION=database
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------- Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@hotelignite.com
MAIL_FROM_NAME=HotelIgnite

# ---------------------------------------------------------- Integraciones
PMS_INVITATION_URL=https://pms.hotelignite.com/invitation

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
